# =================================================================
# ENVIRONMENT TEMPLATE - CAPTIVE PORTAL BANYUWANGI
# SALIN FILE INI MENJADI '.env' LALU ISI DENGAN KREDENSIAL ASLI
# =================================================================

# Database Configuration (PostgreSQL)
POSTGRES_USER=your_db_username
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=captive_portal
DB_PORT=5432

# Backend Service Configuration
BACKEND_PORT=3000
BACKEND_EXTERNAL_PORT=8080

# Web Landing Page Configuration
WEB_EXTERNAL_PORT=8081

# Admin Dashboard Configuration (Orang 3)
DASHBOARD_EXTERNAL_PORT=8082

# PgAdmin Management Configuration
PGADMIN_DEFAULT_EMAIL=your_email@domain.com
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password
PGADMIN_EXTERNAL_PORT=5050